# Credenciales de acceso al ERP UNCP
UNCP_USER=tu_codigo_o_usuario
UNCP_PASS=tu_contrasena

# API Key de Gemini
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo Gemini a usar (opcional - por defecto: gemini-2.0-flash)
# Opciones válidas: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# Proveedor LLM (gemini | ollama)
LLM_PROVIDER=gemini
